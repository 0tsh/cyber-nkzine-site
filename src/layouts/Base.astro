---
interface Props { title: string; description?: string; pagefind?: boolean }
const { title, description = 'A compiled list of North Korean (DPRK) cyber activity, recorded as each source published it.' } = Astro.props;
const full = title === 'DPRK Cyber Index' ? title : `${title} · DPRK Cyber Index`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><rect width=%2216%22 height=%2216%22 fill=%22%23111%22/><rect x=%223%22 y=%223%22 width=%2210%22 height=%2210%22 fill=%22%23e5484d%22/></svg>" />
  <style is:global>
    :root { --bg:#fff; --fg:#161616; --muted:#666; --line:#ddd; --accent:#b3262b; --card:#f6f6f6; }
    @media (prefers-color-scheme: dark) { :root { --bg:#111; --fg:#e8e8e8; --muted:#999; --line:#333; --accent:#ff6b70; --card:#1a1a1a; } }
    * { box-sizing: border-box; }
    body { margin:0; background:var(--bg); color:var(--fg); font:16px/1.55 system-ui,sans-serif; }
    a { color:var(--accent); }
    header.site, main, footer.site { max-width: 62rem; margin: 0 auto; padding: 0 16px; }
    header.site { display:flex; flex-wrap:wrap; gap:.5rem 1.25rem; align-items:baseline; padding-top:1rem; padding-bottom:1rem; border-bottom:1px solid var(--line); }
    header.site .brand { font-weight:700; color:var(--fg); text-decoration:none; margin-right:auto; }
    header.site a { font-size:.95rem; }
    main { padding-top:1.5rem; padding-bottom:3rem; }
    footer.site { color:var(--muted); font-size:.85rem; padding-top:1rem; padding-bottom:2rem; border-top:1px solid var(--line); }
    h1 { line-height:1.2; margin:.2em 0 .6em; overflow-wrap:anywhere; }
    table { border-collapse:collapse; width:100%; }
    th, td { text-align:left; padding:.4rem .6rem; border-bottom:1px solid var(--line); vertical-align:top; overflow-wrap:anywhere; }
    .muted { color:var(--muted); }
    .chips a { display:inline-block; margin:0 .4rem .4rem 0; padding:.1rem .6rem; border:1px solid var(--line); border-radius:99px; text-decoration:none; font-size:.9rem; }
    .entry { background:var(--card); border:1px solid var(--line); border-radius:6px; padding:.8rem 1rem; margin:0 0 1rem; }
    .entry h3 { margin:.1rem 0 .4rem; font-size:1rem; }
    .entry blockquote { margin:.5rem 0; padding-left:.8rem; border-left:3px solid var(--line); white-space:pre-wrap; overflow-wrap:anywhere; }
    dl.facts { display:grid; grid-template-columns:max-content 1fr; gap:.3rem 1rem; }
    dl.facts dt { color:var(--muted); } dl.facts dd { margin:0; overflow-wrap:anywhere; }
    .scroll { overflow-x:auto; }
  </style>
</head>
<body>
  <header class="site">
    <a class="brand" href="/">DPRK Cyber Index</a>
    <a href="/years/">Years</a><a href="/actors/">Actors</a><a href="/sources/">Sources</a>
    <a href="/attacks-on-north-korea/">Attacks on North Korea</a><a href="/methodology/">Methodology</a><a href="/contribute/">Contribute</a><a href="/search/">Search</a>
  </header>
  <main><slot /></main>
  <footer class="site">
    Compiled from public sources and recorded as each source published it. A compilation, not an analysis.
    Quoted text belongs to its original publishers. Data: <a href="https://github.com/0tsh/not-so-awesome-dprk-hacks">data repository</a>.
  </footer>
</body>
</html>
